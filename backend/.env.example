# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_LLM_MODEL=gpt-4o-mini

# Generation. local is development-only and does not call OpenAI.
# Switch evaluation back with LLM_PROVIDER=openai (gpt-4o-mini).
LLM_PROVIDER=local
LOCAL_LLM_MODEL=google/flan-t5-small

# Embeddings. local is development-only and does not call OpenAI embeddings.
# Switch evaluation back with EMBEDDING_PROVIDER=openai (text-embedding-ada-002).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_VECTOR_INDEX_NAME=literature_vector_dev
LOCAL_VECTOR_NODE_LABEL=LiteratureChunkDev

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
VECTOR_TOP_K=5

# Application
APP_ENV=development
# Refuses the development chunking fallback. Requires OPENAI_API_KEY.
EVALUATION_MODE=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
